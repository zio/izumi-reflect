# Use remote JDK 21 (no local JDK required)
build --java_runtime_version=remotejdk_21
build --tool_java_runtime_version=remotejdk_21
build --extra_toolchains=@rules_java//toolchains:all

# Increase JVM memory for scalac
build --action_env=JAVA_OPTS="-Xmx2g -Xss8m"

# Propagate PATH for native tooling (clang for scala-native)
build --action_env=PATH

# Show test output on failure
test --test_output=errors

# Enable disk cache for faster rebuilds
build --disk_cache=~/.cache/bazel-disk

# CI mode: promote warnings to errors (Scala 2.12/2.13)
build:ci --define=CI=true

# Release mode: enable inlining optimizations (Scala 2.12/2.13)
build:release --define=RELEASE=true

# Scoverage (Scala-native instrumentation, JVM only):
#   bazel test --config=scoverage //...
build:scoverage --define=SCOVERAGE=true

# JaCoCo (bytecode-level coverage, JVM only):
#   bazel test --config=jacoco //... --test_tag_filters=jvm
# Reports written to bazel-testlogs/<target>/test.outputs/jacoco.exec
build:jacoco --define=JACOCO=true
build:jacoco --action_env=JACOCO=true

# GraalVM: bazel build --config=graalvm ...
build:graalvm --java_runtime_version=graalvm_21
build:graalvm --extra_toolchains=@graalvm_21_toolchain//:all

# Convenience configs
build:ci --action_env=CI=true
