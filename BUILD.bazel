load("//rules:multiplatform.bzl", "scala_multiplatform_library", "scala_multiplatform_test")
load("//rules:versions.bzl", "BOOPICKLE_REMOVED_OPTS")

# Coverage config settings — activated via --define=SCOVERAGE=true or --define=JACOCO=true
config_setting(
    name = "scoverage",
    define_values = {"SCOVERAGE": "true"},
)

config_setting(
    name = "jacoco",
    define_values = {"JACOCO": "true"},
)

scala_multiplatform_library(
    name = "izumi-reflect-thirdparty-boopickle-shaded",
    base_dir = "izumi-reflect/izumi-reflect-thirdparty-boopickle-shaded",
    remove_scalac_opts = BOOPICKLE_REMOVED_OPTS,
    visibility = ["//visibility:public"],
)

scala_multiplatform_library(
    name = "izumi-reflect",
    base_dir = "izumi-reflect/izumi-reflect",
    deps = [":izumi-reflect-thirdparty-boopickle-shaded"],
    visibility = ["//visibility:public"],
)

scala_multiplatform_test(
    name = "izumi-reflect-test",
    base_dir = "izumi-reflect/izumi-reflect",
    lib_deps = [
        ":izumi-reflect",
        ":izumi-reflect-thirdparty-boopickle-shaded",
    ],
)
