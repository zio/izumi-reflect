#!/usr/bin/env bash

set -euo pipefail

# Check if mudyla is available
if ! command -v mdl &> /dev/null; then
    echo "[info] mudyla (mdl) not found, loading from nix flake..."

    # Use direnv or nix develop to get the environment
    if command -v nix &> /dev/null; then
        exec nix develop --command mdl "$@"
    else
        echo "[error] 'mdl' not found and 'nix' is not available."
        echo "Please install mudyla or use 'direnv allow' to load the nix environment."
        exit 1
    fi
fi

# Execute mudyla with all arguments
exec mdl "$@"
